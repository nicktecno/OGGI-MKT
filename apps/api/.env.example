# Banco (ex.: Postgres local via docker-compose na raiz)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agregador"
# Neon (produção): Console → Connection string. O host inclui o compute, ex. ep-wandering-bread-anvz5ofv.<região>.aws.neon.tech
# DATABASE_URL="postgresql://USER:PASSWORD@ep-wandering-bread-anvz5ofv.<região>.aws.neon.tech/neondb?sslmode=require"

# Segredo para chamadas internas (o app web envia o mesmo valor no header acordado)
INTERNAL_API_SECRET="troque-por-um-segredo-longo"

# Origens CORS (cookies / credentials). Vírgula para várias. Obrigatório em produção alinhar com o domínio real do Next.
# Local: http://localhost:3000
# Produção: https://seu-app.vercel.app,https://www.seudominio.com.br
FRONTEND_URL=http://localhost:3000

# Assinatura JWT da plataforma e alinhamento com o cookie do Next (≥32 caracteres). Obrigatório em produção.
AUTH_SECRET=

# E-mail — notificações. Preferir provedor Resend; senão SMTP.
# https://resend.com/docs/send-with-nodejs
# RESEND_API_KEY=re_xxxx
# MAIL_FROM="Agregador <onboarding@resend.dev>"
#
# SMTP (só se não houver chave de API de e-mail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
#
# Destinatários admin extra (vírgula), além das contas admin ativas no banco
# ADMIN_NOTIFY_EMAILS=

PORT=4000

# --- Stripe (sandbox: chaves de teste no Dashboard → Developers) ---
# Secret da conta da plataforma (começa com sk_test_… em teste).
# STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_…) — Stripe CLI: `stripe listen --forward-to localhost:4000/webhooks/stripe`
# STRIPE_WEBHOOK_SECRET=
# Base do front para URLs padrão do Connect (opcional; senão usa o 1º valor de FRONTEND_URL).
# STRIPE_CONNECT_BASE_URL=http://localhost:3000
# URLs fixas de retorno/refresh do onboarding Connect (opcional).
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/painel/fornecedor
# STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/painel/fornecedor

# --- Cloudflare R2 (imagens da vitrine / marketplace; API compatível com S3) ---
# Crie um bucket R2, chaves de API com permissão de escrita e URL pública (r2.dev ou domínio customizado).
# https://developers.cloudflare.com/r2/
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# URL pública de leitura (sem barra no fim), ex.: https://pub-xxxxxxxxx.r2.dev
# R2_PUBLIC_BASE_URL=
