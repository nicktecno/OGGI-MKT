# Banco (ex.: Postgres local via docker-compose na raiz)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agregador"
# Obrigatório no schema Prisma: em local = igual a DATABASE_URL; no Neon com pooler = URL **direta** (host sem `-pooler-`), para `prisma migrate deploy`.
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/agregador"
# Neon (produção): `DATABASE_URL` = pooled (…-pooler…); `DATABASE_DIRECT_URL` = direct (mesmo user/db, host sem pooler).
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Segredo para chamadas internas (o app web envia o mesmo valor no header acordado)
INTERNAL_API_SECRET="troque-por-um-segredo-longo"
# Ex.: POST /internal/commerce/store-order-lines/posted — marca linha de pedido como postada (rastreio opcional) para aparecer em “Meus pedidos”.

# Origens CORS (cookies / credentials). Vírgula para várias. Obrigatório em produção alinhar com o domínio real do Next.
# Local: http://localhost:3000
# Produção: https://seu-app.vercel.app,https://www.seudominio.com.br
FRONTEND_URL=http://localhost:3000

# Assinatura JWT da plataforma e alinhamento com o cookie do Next (≥32 caracteres). Obrigatório em produção.
AUTH_SECRET=

# E-mail — notificações. Preferir provedor Resend; senão SMTP.
# https://resend.com/docs/send-with-nodejs
# RESEND_API_KEY=re_xxxx
# MAIL_FROM="Agregador <onboarding@resend.dev>"
#
# SMTP (só se não houver chave de API de e-mail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
#
# Destinatários admin extra (vírgula), além das contas admin ativas no banco
# ADMIN_NOTIFY_EMAILS=

PORT=4000

# E-mail do admin oficial (aprovações de cadastro; alinhar com ADMIN_EMAIL do bootstrap).
# PLATFORM_ADMIN_EMAIL=admin@seudominio.com.br

# --- Stripe ---
# Desenvolvimento: sk_test_… | Produção: sk_live_… (mesma chave no web STRIPE_SECRET_KEY).
# STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_…) — Stripe CLI: `stripe listen --forward-to localhost:4000/webhooks/stripe`
# STRIPE_WEBHOOK_SECRET=
# Base do front para URLs padrão do Connect (opcional; senão usa o 1º valor de FRONTEND_URL).
# STRIPE_CONNECT_BASE_URL=http://localhost:3000
# URLs fixas de retorno/refresh do onboarding Connect (opcional).
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/painel/fornecedor
# STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/painel/fornecedor

# --- Cloudflare R2 (imagens da vitrine / marketplace; API compatível com S3) ---
# Crie um bucket R2, chaves de API com permissão de escrita e URL pública (r2.dev ou domínio customizado).
# https://developers.cloudflare.com/r2/
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# URL pública de leitura (sem barra no fim), ex.: https://pub-xxxxxxxxx.r2.dev
# R2_PUBLIC_BASE_URL=

# --- Melhor Envio (OAuth + webhook) ---
# Produção: MELHOR_ENVIO_API_BASE=https://melhorenvio.com.br
# Sandbox (dev): https://sandbox.melhorenvio.com.br
# Com token (OAuth gravado no Postgres após /integrations/melhor-envio/start) OU com variável abaixo,
# o checkout usa cotação real em POST /public/commerce/shipping-quote. Sem Melhor Envio, a cotação falha.
# MELHOR_ENVIO_ACCESS_TOKEN=
# MELHOR_ENVIO_API_BASE=https://sandbox.melhorenvio.com.br
# MELHOR_ENVIO_CLIENT_ID=
# MELHOR_ENVIO_CLIENT_SECRET=
# URL exata do callback (igual à cadastrada na Área Dev), ex.: https://api.modastore.com.br/oauth/melhor-envio/callback
# MELHOR_ENVIO_REDIRECT_URI=
# Alternativa: URL pública da API sem path; o callback será {API_PUBLIC_URL}/oauth/melhor-envio/callback
# API_PUBLIC_URL=https://api.modastore.com.br
# Cabeçalho obrigatório nas chamadas de token: nome do app + e-mail técnico
# MELHOR_ENVIO_USER_AGENT=ModaStore (contato@modastore.com.br)
# Permissões OAuth (espaço). Opcional — há default mínimo para frete.
# MELHOR_ENVIO_SCOPE=shipping-calculate shipping-generate shipping-checkout orders-read shipping-tracking users-read
# Opcional: restringir serviços na cotação (IDs separados por vírgula, conforme doc ME).
# MELHOR_ENVIO_SERVICE_IDS=1,2,18
# Etiquetas insumos (fornecedor → costureira): CPF/CNPJ vêm do registo / “Minha conta” de cada utilizador
# (`fiscal_document` na base), não de variáveis aqui. Saldo na carteira ME continua necessário.
